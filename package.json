{
  "name": "verzel-store-qa-teste-tecnico",
  "version": "1.0.0",
  "description": "Teste técnico QA Júnior - Verzel: cenários BDD (Gherkin), execução, bugs e automação Playwright + playwright-bdd da entrega VZS-142 (cupom de desconto e frete grátis) da Verzel Store.",
  "private": true,
  "scripts": {
    "bddgen": "bddgen",
    "pretest": "npm run bddgen",
    "test": "playwright test",
    "test:ui": "npm run bddgen && playwright test --ui",
    "test:relatorio": "playwright show-report tests/relatorio-html",
    "test:extra:acessibilidade": "bddgen --config extra-acessibilidade/tests/playwright.config.js && playwright test --config extra-acessibilidade/tests/playwright.config.js",
    "test:extra:acessibilidade:relatorio": "playwright show-report extra-acessibilidade/tests/relatorio-html"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "playwright-bdd": "^9.2.1"
  }
}
